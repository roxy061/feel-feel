# ==========================================
# 3NFM Multi-Tenant SaaS Environment Config
# ==========================================

# 1. Domain Configuration
# For local development: localhost:3000
# For production (Vercel): your-domain.com or your-app.vercel.app
ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# 2. Database Configuration (Supports Local MySQL, TiDB Cloud Serverless, Aiven, PlanetScale)
# Option A: Connection URL (e.g. from TiDB Cloud Console)
# DATABASE_URL=mysql://<user>:<password>@<gateway-host>:4000/3nfm_saas?ssl={"rejectUnauthorized":false}

# Option B: Individual Parameters
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=3nfm_saas
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Alternative / Legacy Prefix
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=3nfm_saas

# 3. Payment Gateway Configuration
# Default TrueMoney Phone for receiving Angpao vouchers
DEFAULT_TRUEMONEY_PHONE=0812345678
