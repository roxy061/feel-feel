# 3NFM SaaS Environment Variables Example

# Domain Configuration
ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Database Configuration (Supports local MySQL and Cloud DB like TiDB Cloud / Aiven)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=3nfm_saas
DB_SSL=false

# Legacy / Alternative Prefix
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=3nfm_saas
